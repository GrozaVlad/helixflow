{
  "Comment":"Two-stage Boltz workflow with Spot-first GPU and On-Demand failure fallback",
  "StartAt":"Prepare MSA",
  "States":{
    "Prepare MSA":{"Type":"Task","Resource":"arn:aws:states:::batch:submitJob.sync","Parameters":{"JobName.$":"States.Format('msa-{}', $.job_id)","JobQueue":"${cpu_queue}","JobDefinition":"${msa_definition}","ContainerOverrides":{"Environment":[{"Name":"MANIFEST_KEY","Value.$":"$.manifest_key"}]},"Tags":{"ResearchJobId.$":"$.job_id"}},"ResultPath":"$.msa","Next":"Predict on Spot"},
    "Predict on Spot":{"Type":"Task","Resource":"arn:aws:states:::batch:submitJob.sync","Parameters":{"JobName.$":"States.Format('boltz-spot-{}', $.job_id)","JobQueue":"${gpu_spot_queue}","JobDefinition":"${boltz_definition}","ContainerOverrides":{"Environment":[{"Name":"MANIFEST_KEY","Value.$":"$.manifest_key"},{"Name":"PREPARED_MANIFEST_KEY","Value.$":"States.Format('jobs/{}/{}/prepared/manifest.json', $.owner_id, $.job_id)"},{"Name":"ATTEMPT","Value":"1"}]},"Tags":{"ResearchJobId.$":"$.job_id"}},"ResultPath":"$.prediction","Catch":[{"ErrorEquals":["States.ALL"],"ResultPath":"$.spot_error","Next":"Predict on On-Demand"}],"Next":"Finalize"},
    "Predict on On-Demand":{"Type":"Task","Resource":"arn:aws:states:::batch:submitJob.sync","Parameters":{"JobName.$":"States.Format('boltz-od-{}', $.job_id)","JobQueue":"${gpu_od_queue}","JobDefinition":"${boltz_definition}","ContainerOverrides":{"Environment":[{"Name":"MANIFEST_KEY","Value.$":"$.manifest_key"},{"Name":"PREPARED_MANIFEST_KEY","Value.$":"States.Format('jobs/{}/{}/prepared/manifest.json', $.owner_id, $.job_id)"},{"Name":"ATTEMPT","Value":"2"}]},"Tags":{"ResearchJobId.$":"$.job_id"}},"ResultPath":"$.prediction","Next":"Set fallback attempt"},
    "Set fallback attempt":{"Type":"Pass","Result":{"attempt":2},"ResultPath":"$.fallback","Next":"Finalize fallback"},
    "Finalize fallback":{"Type":"Task","Resource":"arn:aws:states:::lambda:invoke","Parameters":{"FunctionName":"${finalizer}","Payload":{"job_id.$":"$.job_id","owner_id.$":"$.owner_id","attempt":2}},"End":true},
    "Finalize":{"Type":"Task","Resource":"arn:aws:states:::lambda:invoke","Parameters":{"FunctionName":"${finalizer}","Payload":{"job_id.$":"$.job_id","owner_id.$":"$.owner_id","attempt":1}},"End":true}
  }
}